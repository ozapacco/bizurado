# Copie para .env.local (local) ou configure como Environment Variables na Vercel.

# Postgres (Neon) — connection string do projeto. O app remove channel_binding
# automaticamente para o caminho WebSocket; pode colar a string completa da Neon.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Senha única do app (portão do middleware). Use uma senha forte em produção.
APP_PASSWORD="defina-uma-senha-forte"
